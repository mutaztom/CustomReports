<?xml version="1.0" encoding="UTF-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="commgroup">
        <xs:complexType>
            <xs:sequence maxOccurs="unbounded" minOccurs="1">
                <xs:element name="catid" type="xs:string">
                </xs:element>
                <xs:element name="commgroupid" type="xs:string"/>
                <xs:element name="catname" type="xs:string">
                </xs:element>
                <xs:element name="arcatname" type="xs:string">
                </xs:element>
                <xs:element name="maincat" type="xs:string">
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="root">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="commgroup" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>