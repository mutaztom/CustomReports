<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="imfullimduty" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Empty" uuid="83ebf2cc-56b9-4e7b-9a2e-161c6fce9f69">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="288"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="703"/>
	<style name="rtstyle" mode="Transparent" fontName="Serif">
		<paragraph lineSpacing="1_1_2"/>
	</style>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<queryString language="SQL">
		<![CDATA[select com_grp_imd2."Group Name" "Group Name",com_grp_imd2.tot_wgt2 "Net Mass KG",com_grp_imd2.tot_cif2 "Custom Value SDG"
,com_grp_imd2.tot_cif_usd2 "Custom Value USD",com_grp_imd2.tot_imd2 "Import Duty SDG", others_tax."Others Taxes" "Others Taxes SDG"
from 
(select com_grp."Group Name",com_grp.tot_wgt tot_wgt2,com_grp.tot_cif tot_cif2,com_grp.tot_cif_usd tot_cif_usd2,
com_grp_imd.tot_imd tot_imd2
from (SELECT ALL NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') "Group Name", 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_WGT_NET) tot_wgt, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, 
ROUND(SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWCURUPDATE_ITM,
                                         AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                            
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWCURUPDATE_ITM,
                             AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_usd
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.N_COMGRP
WHERE AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G(+)))
GROUP BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others')
ORDER BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') DESC) com_grp,
(SELECT ALL NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') "Group Name", 
SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) tot_imd
FROM AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.N_COMGRP, AWUNADM.SAD_TAX
WHERE (AWUNADM.SAD_TAX.TAX_LIN_COD='IMD'
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR))
GROUP BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others')
ORDER BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') DESC) com_grp_imd
where com_grp."Group Name"=com_grp_imd."Group Name") com_grp_imd2,
(select com_grp_vat."Group Name",com_grp_vat.tot_VAT+com_grp_ADT.tot_ADT "Others Taxes"
from 
(SELECT ALL NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') "Group Name", 
SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) tot_vat
FROM AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.N_COMGRP, AWUNADM.SAD_TAX
WHERE (AWUNADM.SAD_TAX.TAX_LIN_COD='VAT'
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR))
GROUP BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others')
ORDER BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') DESC) com_grp_vat,
(SELECT ALL NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') "Group Name", 
SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) tot_ADT
FROM AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.N_COMGRP, AWUNADM.SAD_TAX
WHERE (AWUNADM.SAD_TAX.TAX_LIN_COD='ADT'
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR))
GROUP BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others')
ORDER BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') DESC) com_grp_adt
where com_grp_vat."Group Name"=com_grp_ADT."Group Name") others_tax
where com_grp_imd2."Group Name"=others_tax."Group Name"
order by 1 desc]]>
	</queryString>
	<field name="Group Name" class="java.lang.String"/>
	<field name="Net Mass KG" class="java.math.BigDecimal"/>
	<field name="Custom Value SDG" class="java.math.BigDecimal"/>
	<field name="Custom Value USD" class="java.math.BigDecimal"/>
	<field name="Import Duty SDG" class="java.math.BigDecimal"/>
	<field name="Others Taxes SDG" class="java.math.BigDecimal"/>
	<variable name="NetSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Net Mass KG}]]></variableExpression>
	</variable>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value SDG}]]></variableExpression>
	</variable>
	<variable name="USDSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value USD}]]></variableExpression>
	</variable>
	<variable name="IMDSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Import Duty SDG}]]></variableExpression>
	</variable>
	<variable name="OtherSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Others Taxes SDG}]]></variableExpression>
	</variable>
	<group name="COMCODE">
		<groupExpression><![CDATA[$F{TAR_HSC_NB1}]]></groupExpression>
	</group>
