<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Top100conlist" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="9b3ed759-204a-4ba2-9205-649a241ccc70">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Test"/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[select top_con.CMP_NAM,top_con.tot_cif,top_con.cnt,top_con.LST_NAM
from
(SELECT ALL AWUNADM.UNCMPTAB.CMP_COD, 
AWUNADM.UNCMPTAB.CMP_NAM, COUNT(DISTINCT AWUNADM.GEN_ITEM_N_2.INSTANCEID) cnt, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, AWUNADM.SEL_LISTS.LST_NAM LST_NAM
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, 
AWUNADM.UNCMPTAB, AWUNADM.SEL_LISTS_CMP, AWUNADM.SEL_LISTS
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL)
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.CMP_CON_COD=AWUNADM.UNCMPTAB.CMP_COD)
 AND (AWUNADM.UNCMPTAB.CMP_COD=AWUNADM.SEL_LISTS_CMP.COD(+))
 AND (AWUNADM.SEL_LISTS_CMP.INSTANCE_ID=AWUNADM.SEL_LISTS.INSTANCE_ID))
GROUP BY AWUNADM.UNCMPTAB.CMP_COD, 
AWUNADM.UNCMPTAB.CMP_NAM, AWUNADM.SEL_LISTS.LST_NAM
ORDER BY SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) DESC ) top_con
where rownum<101]]>
	</queryString>
	<field name="CMP_NAM" class="java.lang.String"/>
	<field name="TOT_CIF" class="java.math.BigDecimal"/>
	<field name="CNT" class="java.math.BigDecimal"/>
	<field name="LST_NAM" class="java.lang.String"/>
	<sortField name="TOT_CIF" order="Descending"/>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF}]]></variableExpression>
	</variable>
	<variable name="CountSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CNT}]]></variableExpression>
	</variable>
	<variable name="Rows" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[$V{COLUMN_COUNT}]]></variableExpression>
	</variable>
