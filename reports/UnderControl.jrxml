<!-- 2019-10-05T13:08:34 -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="UnderControl" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="de4c43b6-8a62-473c-b5dc-c760f9681d61">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL AWUNADM.S043_TABLE.CONSIGNEE, 
AWUNADM.UNCMPTAB.CMP_NAM, SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE) tot_val, 
SUM(AWUNADM.S043_TABLE.DIFF_VALUE) tot_dif_val, COUNT(AWUNADM.S043_TABLE.CONSIGNEE) cnt, 
ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100) Com_per, 
NVL(AWUNADM.SEL_LISTS.LST_COD, 'Not Found in any LIST') current_List, 
DECODE(SIGN(11-ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)), 
1, NVL(AWUNADM.SEL_LISTS.LST_COD, 'Not Found in any LIST'), 
0, NVL(AWUNADM.SEL_LISTS.LST_COD, 'Not Found in any LIST'))||DECODE(TO_NUMBER(DECODE(SIGN(ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)-11), 
-1, 0, 0, 1, SIGN(ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)-11)))*TO_NUMBER(DECODE(SIGN(50-ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)), 
-1, 0, 0, 1, SIGN(50-ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)))), 
1, 'UNDER-CONTROL-A')||DECODE(TO_NUMBER(DECODE(SIGN(ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)-51), 
-1, 0, 0, 1, SIGN(ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)-51)))*TO_NUMBER(DECODE(SIGN(100-ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)), 
-1, 0, SIGN(100-ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)))), 
1, 'UNDER-CONTROL-B')||DECODE(SIGN(ROUND((SUM(AWUNADM.S043_TABLE.DIFF_VALUE)/SUM(AWUNADM.S043_TABLE.ORIGENAL_VALUE))*100)-101), 
1, 'UNDER-CONTROL-C') New_list2
FROM AWUNADM.S043_TABLE, 
AWUNADM.UNCMPTAB, AWUNADM.MAX_SEL_LISTS_CMP, AWUNADM.SEL_LISTS
WHERE (AWUNADM.S043_TABLE.REG_DATE BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.S043_TABLE.DIFF_VALUE<>0)
 AND  ((AWUNADM.S043_TABLE.CONSIGNEE=AWUNADM.UNCMPTAB.CMP_COD(+))
 AND (AWUNADM.UNCMPTAB.CMP_COD=AWUNADM.MAX_SEL_LISTS_CMP.COD(+))
 AND (AWUNADM.MAX_SEL_LISTS_CMP.M_INSTANCE=AWUNADM.SEL_LISTS.INSTANCE_ID))
GROUP BY AWUNADM.S043_TABLE.CONSIGNEE, 
AWUNADM.UNCMPTAB.CMP_NAM, NVL(AWUNADM.SEL_LISTS.LST_COD, 'Not Found in any LIST'), 
NVL(AWUNADM.SEL_LISTS.LST_COD, 'Not Found in any LIST')
HAVING COUNT(AWUNADM.S043_TABLE.CONSIGNEE)>1]]>
	</queryString>
	<field name="CONSIGNEE" class="java.lang.String"/>
	<field name="CMP_NAM" class="java.lang.String"/>
	<field name="TOT_VAL" class="java.math.BigDecimal"/>
	<field name="TOT_DIF_VAL" class="java.math.BigDecimal"/>
	<field name="CNT" class="java.math.BigDecimal"/>
	<field name="COM_PER" class="java.math.BigDecimal"/>
	<field name="CURRENT_LIST" class="java.lang.String"/>
	<field name="NEW_LIST2" class="java.lang.String"/>
