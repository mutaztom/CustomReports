<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ExTradeExchangeCountries" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="fcdf1171-40f0-42bf-a4cf-70b248dc97c4">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL NVL(AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_DES_COD, 
AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_FLT) "Country code ", 
AWUNADM.UNCTYTAB.CTY_DSC "Country of Distination" , SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) "Custom Value SDG", 
ROUND(SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
            
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) "Custom Value USD"
FROM AWUNADM.GEN_ITEM_N_EXP, AWUNADM.UNCTYTAB
WHERE (AWUNADM.GEN_ITEM_N_EXP.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.UNCTYTAB.VALID_TO IS NULL)
 AND  (AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_DES_COD=AWUNADM.UNCTYTAB.CTY_COD)
GROUP BY NVL(AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_DES_COD, 
AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_FLT), 
AWUNADM.UNCTYTAB.CTY_DSC
ORDER BY SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) DESC]]>
	</queryString>
	<field name="Country code " class="java.lang.String"/>
	<field name="Country of Distination" class="java.lang.String"/>
	<field name="Custom Value SDG" class="java.math.BigDecimal"/>
	<field name="Custom Value USD" class="java.math.BigDecimal"/>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value SDG}]]></variableExpression>
	</variable>
	<variable name="USDSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value USD}]]></variableExpression>
	</variable>
