<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CountryAgreementsLoss" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="b67d47a5-f20f-4612-9a5c-3ac16908ce42">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL AWUNADM.GEN_ITEM_N_2.TAR_PRF, AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, ROUND(SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_USD, 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) tot_loss
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.SAD_RELIEF
WHERE (AWUNADM.GEN_ITEM_N_2.TAR_PRF IN ('COMESA','ARU')
 AND AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY<>'ETH'
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR))
GROUP BY AWUNADM.GEN_ITEM_N_2.TAR_PRF, AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY
union
SELECT ALL'Bilateral'  Cuase_Of_Loss, AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, ROUND(SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_USD, 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) tot_loss
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.SAD_RELIEF
WHERE (AWUNADM.GEN_ITEM_N_2.TAR_PRF IN ('COMESA','ARU')
 AND AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY='ETH'
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR))
GROUP BY AWUNADM.GEN_ITEM_N_2.TAR_PRF, AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY
union
SELECT ALL AWUNADM.SAD_RELIEF.REL_CODE Cuase_Of_Loss, AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) Custom_Value_SDG, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                         
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) Custom_Value_USD, 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) Duty_Loss_SDG
FROM AWUNADM.SAD_TAX, AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.SAD_RELIEF, AWUNADM.PRF_DESC_VIEW
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_TAX.TAX_LIN_COD='IMD'
 AND AWUNADM.SAD_RELIEF.TAX_CODE='IMD'
 and AWUNADM.GEN_ITEM_N_2.TAR_PRF not IN ('COMESA','ARU')
 AND AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY<>'ETH')
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR(+))
 AND (AWUNADM.SAD_TAX.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID)
 AND (AWUNADM.SAD_TAX.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR)
 AND (AWUNADM.PRF_DESC_VIEW.TAR_PRF=AWUNADM.GEN_ITEM_N_2.TAR_PRF)
 AND (AWUNADM.PRF_DESC_VIEW.TAR_PRF=AWUNADM.SAD_RELIEF.REL_CODE))
GROUP BY AWUNADM.SAD_RELIEF.REL_CODE,AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY
union 
SELECT ALL AWUNADM.SAD_RELIEF.REL_CODE,AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                     
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1)))tot_cif_usd, 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) tot_loss
FROM AWUNADM.SAD_TAX, 
AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.SAD_RELIEF
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_TAX.TAX_LIN_COD='IMD'
 AND AWUNADM.SAD_RELIEF.TAX_CODE='IMD'
 AND AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY<>'ETH'
 AND AWUNADM.SAD_RELIEF.REL_CODE IN ('FIN'))
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR(+))
 AND (AWUNADM.SAD_TAX.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID)
 AND (AWUNADM.SAD_TAX.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR))
GROUP BY AWUNADM.SAD_RELIEF.REL_CODE,AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY
union 
SELECT ALL AWUNADM.EXT_NAT_DESC.G_DESC, AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                 
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) tot_cif_usd, 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) tot_rel_loss
FROM AWUNADM.SAD_TAX, AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.SAD_RELIEF, AWUNADM.EXT_NAT_DESC
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_TAX.TAX_LIN_COD='IMD'
 AND AWUNADM.SAD_RELIEF.TAX_CODE='IMD'
 AND  AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY<>'ETH')
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR(+))
 AND (AWUNADM.SAD_TAX.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID)
 AND (AWUNADM.SAD_TAX.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR)
 AND (AWUNADM.SAD_RELIEF.REL_CODE=AWUNADM.GEN_ITEM_N_2.TAR_PRC_NAT)
 AND (AWUNADM.GEN_ITEM_N_2.EXT_NAT not in('400042','400043','400044','400045','400046','400047','400048'))
 AND (AWUNADM.GEN_ITEM_N_2.TAR_PRC_EXT=AWUNADM.EXT_NAT_DESC.EXT)
 AND (AWUNADM.GEN_ITEM_N_2.TAR_PRC_NAT=AWUNADM.EXT_NAT_DESC.NAT))
GROUP BY AWUNADM.EXT_NAT_DESC.G_DESC,AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY
union 
SELECT ALL AWUNADM.NAT_REL_VIEW3.DESC_OTHERS,AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                   
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) tot_cif_usd, 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) tot_rel_loss
FROM AWUNADM.SAD_TAX, AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.SAD_RELIEF, AWUNADM.NAT_REL_VIEW3
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_TAX.TAX_LIN_COD='IMD'
 AND AWUNADM.SAD_RELIEF.TAX_CODE='IMD'
 and AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY<>'ETH')
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR(+))
 AND (AWUNADM.SAD_TAX.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID)
 AND (AWUNADM.SAD_TAX.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR)
 AND (AWUNADM.SAD_RELIEF.REL_CODE=AWUNADM.GEN_ITEM_N_2.TAR_PRC_NAT)
 AND (AWUNADM.NAT_REL_VIEW3.REL_CODE=AWUNADM.SAD_RELIEF.REL_CODE)  And AWUNADM.GEN_ITEM_N_2.TAR_PRC_EXT||AWUNADM.GEN_ITEM_N_2.TAR_PRC_NAT  not in (SELECT ALL AWUNADM.EXT_NAT_DESC.EXT||AWUNADM.EXT_NAT_DESC.NAT Ext_Nat
FROM AWUNADM.EXT_NAT_DESC))
GROUP BY AWUNADM.NAT_REL_VIEW3.DESC_OTHERS,AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY]]>
	</queryString>
	<field name="TAR_PRF" class="java.lang.String"/>
	<field name="GDS_ORG_CTY" class="java.lang.String"/>
	<field name="TOT_CIF" class="java.math.BigDecimal"/>
	<field name="TOT_CIF_USD" class="java.math.BigDecimal"/>
	<field name="TOT_LOSS" class="java.math.BigDecimal"/>
	<sortField name="GDS_ORG_CTY"/>
	<variable name="SDGSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF}]]></variableExpression>
	</variable>
	<variable name="USDSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF_USD}]]></variableExpression>
	</variable>
	<variable name="LossSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_LOSS}]]></variableExpression>
	</variable>
	<variable name="SDGSum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF}]]></variableExpression>
	</variable>
	<variable name="USDSum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF_USD}]]></variableExpression>
	</variable>
	<variable name="LossSum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_LOSS}]]></variableExpression>
	</variable>
	<group name="Group1">
		<groupExpression><![CDATA[$F{GDS_ORG_CTY}]]></groupExpression>
