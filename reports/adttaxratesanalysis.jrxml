<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ADT TAX RATE ANALYSIS" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="dab12ced-a494-4492-825a-28c5c5ae293b">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<template><![CDATA[System.getenv("CUSTREPDATA")+"/reports/rtstyle.jrtx"]]></template>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{JASPER_REPORT}.getName()]]></defaultValueExpression>
	</parameter>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select gen_itm_tar.rate_n "Rate",gen_itm_tar.tot_wgt "Net Mass (Kg)",gen_itm_tar.tot_cif "Custom Value (SDG)",gen_itm_tar.tot_cif_usd "Custom Value (USD)",
gen_itm_tar_tax.tot_duty "DUTY (SDG)",gen_itm_tar_tax.duty_collect "DUTY Collected (SDG)",gen_itm_tar_tax.tot_duty_loss2 "DUTY LOSS (SDG)"
from (SELECT ALL SUM(AWUNADM.GEN_ITEM_N_2.VIT_WGT_NET) tot_wgt, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) tot_cif_usd, 
TO_NUMBER(NVL(TAR_T02, 
0)) rate_n, 
SUM(TO_NUMBER(NVL(TAR_T02, 
0))*AWUNADM.GEN_ITEM_N_2.VIT_CIF) duty
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL)
 AND  (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
GROUP BY TO_NUMBER(NVL(TAR_T02, 
0))
ORDER BY TO_NUMBER(NVL(TAR_T02, 
0)) ASC) gen_itm_tar,(SELECT ALL 
TO_NUMBER(AWUNADM.N_UNTARTAB.TAR_T02) rate2_n, 
SUM(0.01*to_number(AWUNADM.N_UNTARTAB.TAR_T02)*AWUNADM.GEN_ITEM_N_2.VIT_CIF*(0.01*TO_NUMBER(AWUNADM.N_UNTARTAB.TAR_T01)+1)) tot_duty,

SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) duty_collect, 

SUM(0.01*NVL(to_number(AWUNADM.N_UNTARTAB.TAR_T02), 0)*AWUNADM.GEN_ITEM_N_2.VIT_CIF-NVL(AWUNADM.SAD_TAX.TAX_LIN_AMT, 0)) tot_duty_loss2,
SUM(0.01*to_number(AWUNADM.N_UNTARTAB.TAR_T02)*AWUNADM.GEN_ITEM_N_2.VIT_CIF*(0.01*TO_NUMBER(AWUNADM.N_UNTARTAB.TAR_T01)+1))-(SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT)+SUM(0.01*NVL(AWUNADM.SAD_TAX.TAX_LIN_RAT, 0)*AWUNADM.GEN_ITEM_N_2.VIT_CIF*((TO_NUMBER(AWUNADM.N_UNTARTAB.TAR_T01)/100)+1)-NVL(AWUNADM.SAD_TAX.TAX_LIN_AMT, 0))) dif, 
SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT)+SUM(0.01*NVL(AWUNADM.SAD_TAX.TAX_LIN_RAT, 0)*AWUNADM.GEN_ITEM_N_2.VIT_CIF*((TO_NUMBER(AWUNADM.N_UNTARTAB.TAR_T01)/100)+1)-NVL(AWUNADM.SAD_TAX.TAX_LIN_AMT, 0)) col_loss
FROM AWUNADM.SAD_TAX, AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_TAX.TAX_LIN_COD='ADT')
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR(+)))
GROUP BY TO_NUMBER(AWUNADM.N_UNTARTAB.TAR_T02)) gen_itm_tar_tax
where gen_itm_tar.rate_n=gen_itm_tar_tax.rate2_n(+)
order by 1]]>
	</queryString>
	<field name="Rate" class="java.math.BigDecimal"/>
	<field name="Net Mass (Kg)" class="java.math.BigDecimal"/>
	<field name="Custom Value (SDG)" class="java.math.BigDecimal"/>
	<field name="Custom Value (USD)" class="java.math.BigDecimal"/>
	<field name="DUTY (SDG)" class="java.math.BigDecimal"/>
	<field name="DUTY Collected (SDG)" class="java.math.BigDecimal"/>
	<field name="DUTY LOSS (SDG)" class="java.math.BigDecimal"/>
	<variable name="NetSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Net Mass (Kg)}]]></variableExpression>
	</variable>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="USDSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (USD)}]]></variableExpression>
	</variable>
	<variable name="DutySum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUTY (SDG)}]]></variableExpression>
	</variable>
	<variable name="DutyCollSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUTY Collected (SDG)}]]></variableExpression>
	</variable>
	<variable name="DutyLossSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUTY LOSS (SDG)}]]></variableExpression>
	</variable>
	<variable name="Custom Value (sdg)_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}]]></variableExpression>
	</variable>
	<variable name="Variable_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}.doubleValue() / $V{SDGSum}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="Custom Value (sdg)_1_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}]]></variableExpression>
	</variable>
	<variable name="SDGSum_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{SDGSum}]]></variableExpression>
	</variable>
	<variable name="Custom Value (sdg)_2_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}]]></variableExpression>
	</variable>
	<variable name="Percentage" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}.doubleValue()/$V{SDGSum}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="Custom Value (sdg)_3_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}]]></variableExpression>
	</variable>
