<!-- 2019-10-05T11:29:01 -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TradeBalanceCountries" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="a5bbf9a2-fec1-4752-a515-bdb75197275d">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[select exp_table."Country Code",exp_table."Country of Distination" ,exp_table."Custom Value USD" "EXP Value USD",

nvl(imp_table."Custom Value USD",0) "IMP Value USD",
exp_table."Custom Value USD"-nvl(imp_table."Custom Value USD",0) "Balance"
from
(SELECT ALL nvl(AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_DES_COD,AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_FLT) "Country Code",
AWUNADM.UNCTYTAB.CTY_DSC "Country of Distination",
 SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) "Custom Value SDG", 
ROUND(SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                          
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) "Custom Value USD"
FROM AWUNADM.GEN_ITEM_N_EXP,AWUNADM.UNCTYTAB
WHERE (AWUNADM.GEN_ITEM_N_EXP.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
AND AWUNADM.UNCTYTAB.VALID_TO IS NULL)
 AND  (AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_DES_COD=AWUNADM.UNCTYTAB.CTY_COD)
GROUP BY nvl(AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_DES_COD,AWUNADM.GEN_ITEM_N_EXP.GEN_CTY_FLT),AWUNADM.UNCTYTAB.CTY_DSC 

) exp_table,
(SELECT  AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY "Country Code" , 
AWUNADM.UNCTYTAB.CTY_DSC "Country of Distination",
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) "Custom Value SDG", 
ROUND(SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                          
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) "Custom Value USD"
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB,AWUNADM.UNCTYTAB
WHERE AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
  AND AWUNADM.UNCTYTAB.VALID_TO IS NULL
 AND  AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY=AWUNADM.UNCTYTAB.CTY_COD 
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND  AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6
GROUP BY AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY,AWUNADM.UNCTYTAB.CTY_DSC

) imp_table
where exp_table."Country Code"=imp_table."Country Code"(+)
order by "Balance" Desc]]>
	</queryString>
	<field name="Country Code" class="java.lang.String"/>
	<field name="Country of Distination" class="java.lang.String"/>
	<field name="EXP Value USD" class="java.math.BigDecimal"/>
	<field name="IMP Value USD" class="java.math.BigDecimal"/>
	<field name="Balance" class="java.math.BigDecimal"/>
	<sortField name="IMP Value USD" order="Descending"/>
	<variable name="EXSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{EXP Value USD}]]></variableExpression>
	</variable>
	<variable name="IMSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{IMP Value USD}]]></variableExpression>
	</variable>
	<variable name="BalaSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Balance}]]></variableExpression>
	</variable>
