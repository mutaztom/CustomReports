			<textField pattern="###,###.00">
				<reportElement style="rtstyle" x="39" y="0" width="80" height="20" uuid="feab5f01-ef74-48b9-97b5-ad1336a5af25">
					<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="3440f698-60c4-4405-9bf9-bd51dd0497b8"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
