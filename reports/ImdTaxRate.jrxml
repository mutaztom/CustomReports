	<detail>
		<band height="20" splitType="Stretch">
			<textField pattern="###">
				<reportElement style="rtstyle" x="-10" y="0" width="49" height="20" uuid="eb7794df-675f-4771-8201-57b3296e41be">
					<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="c1cd60fd-d328-4ffe-9db7-56375a712e82"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
