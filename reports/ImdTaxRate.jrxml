<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ImdTaxRate" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2928e72f-6adb-4620-bc39-21c80a6aa135">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Test"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[select gen_itm_tar.rate_n "Rate",gen_itm_tar.tot_wgt "Net Mass (Kg)",gen_itm_tar.tot_cif "Custom Value (sdg)",gen_itm_tar.tot_cif_usd "Custom Value (USD)",
gen_itm_tar.duty "DUTY (SDG)",gen_itm_tar_tax.duty_collected "DUTY Collected (SDG)",gen_itm_tar_rel.tot_rel "DUTY LOSS (SDG)"
from (select no_sugar.tot_wgt+nvl(with_square.tot_wgt,0) tot_wgt,no_sugar.tot_cif+nvl(with_square.tot_cif,0) tot_cif,no_sugar.tot_cif_usd+nvl(with_square.tot_cif_usd,0) tot_cif_usd,no_sugar.rate_n,
no_sugar.duty+nvl(with_square.duty,0) duty
from
(SELECT ALL SUM(AWUNADM.GEN_ITEM_N_2.VIT_WGT_NET) tot_wgt, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                        AWUNADM. AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                           
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) tot_cif_usd, 
TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01),0)) rate_n, 
SUM(TO_NUMBER(NVL(TAR_T01,0))*AWUNADM.GEN_ITEM_N_2.VIT_CIF/100) duty
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND SUBSTR(AWUNADM.GEN_ITEM_N_2.TAR_HSC_NB1, 1, 4) NOT IN ('1701', '1001'))
 AND  (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
GROUP BY TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01),0))) no_sugar,(
SELECT ALL SUM(AWUNADM.GEN_ITEM_N_2.VIT_WGT_NET) tot_wgt, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                           
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) tot_cif_usd, 
TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, AWUNADM.N_UNTARTAB.TAR_T01, 3), 0)) rate_n, 
SUM(TO_NUMBER(NVL(TAR_T01,0))*AWUNADM.GEN_ITEM_N_2.VIT_CIF/100) duty
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND SUBSTR(AWUNADM.GEN_ITEM_N_2.TAR_HSC_NB1, 1, 4) IN ('1701', '1001'))
 AND  (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
GROUP BY TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, AWUNADM.N_UNTARTAB.TAR_T01, 3), 0))) with_square
where no_sugar.rate_n=with_square.rate_n(+)) gen_itm_tar,(select duty_No_Sugar_wheat.rate_n ,duty_No_Sugar_wheat.duty_collected+nvl(duty_Sugar_wheat.duty_collected_sugar,0) duty_collected
from
(SELECT ALL TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01), 
0)) rate_n, 
SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) duty_collected
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.SAD_TAX
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_TAX.TAX_LIN_COD IN 'IMD'
 AND SUBSTR(AWUNADM.GEN_ITEM_N_2.TAR_HSC_NB1, 1, 4) NOT IN ('1701', '1001'))
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR(+)))
GROUP BY TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01), 
0))
ORDER BY TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01), 
0)) ASC) duty_No_Sugar_wheat,(SELECT ALL TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, AWUNADM.N_UNTARTAB.TAR_T01, 3), 0)) rate_n, 
SUM(AWUNADM.SAD_TAX.TAX_LIN_BSE*AWUNADM.SAD_TAX.TAX_LIN_RAT) duty_collected_sugar
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.SAD_TAX
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_TAX.TAX_LIN_COD IN 'IMD'
 AND SUBSTR(AWUNADM.GEN_ITEM_N_2.TAR_HSC_NB1, 1, 4) IN ('1701', '1001'))
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR(+)))
GROUP BY TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, AWUNADM.N_UNTARTAB.TAR_T01, 3), 0))
ORDER BY TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, AWUNADM.N_UNTARTAB.TAR_T01, 3), 0)) ASC) duty_Sugar_wheat
where duty_No_Sugar_wheat.rate_n=duty_Sugar_wheat.rate_n(+)
order by 1) gen_itm_tar_tax,(SELECT ALL TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01), 
0)) rate_n, 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) tot_rel
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.SAD_RELIEF
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_RELIEF.TAX_CODE='IMD')
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR(+)))
GROUP by TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01), 
0))
ORDER BY TO_NUMBER(NVL(TAR_T01, 
0)) ASC) gen_itm_tar_rel

where gen_itm_tar.rate_n=gen_itm_tar_tax.rate_n(+)
 and gen_itm_tar.rate_n=gen_itm_tar_rel.rate_n(+)
order by 1]]>
	</queryString>
	<field name="Rate" class="java.math.BigDecimal"/>
	<field name="Net Mass (Kg)" class="java.math.BigDecimal"/>
	<field name="Custom Value (sdg)" class="java.math.BigDecimal"/>
	<field name="Custom Value (USD)" class="java.math.BigDecimal"/>
	<field name="DUTY (SDG)" class="java.math.BigDecimal"/>
	<field name="DUTY Collected (SDG)" class="java.math.BigDecimal"/>
	<field name="DUTY LOSS (SDG)" class="java.math.BigDecimal"/>
	<variable name="NetSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Net Mass (Kg)}]]></variableExpression>
	</variable>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (sdg)}]]></variableExpression>
	</variable>
	<variable name="USDSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (USD)}]]></variableExpression>
	</variable>
	<variable name="DutySum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUTY (SDG)}]]></variableExpression>
	</variable>
	<variable name="CollSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUTY Collected (SDG)}]]></variableExpression>
	</variable>
	<variable name="LosSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUTY LOSS (SDG)}]]></variableExpression>
	</variable>
