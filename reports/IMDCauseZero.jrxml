				<reportElement mode="Opaque" x="288" y="0" width="80" height="20" backcolor="#DBD7D7" uuid="0e17aa68-392b-4814-95dc-a94b02013b92">
					<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="4fc5453f-6b3a-4f3d-8889-51256442ce33"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
