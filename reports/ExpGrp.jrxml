<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ExpGrp" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="ddc03851-faaa-4618-be72-436b4c313ceb">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[select all_exp_grp.G_Name, sum("Net Mass KG") "Net Mass KG", sum(tot_cif) "Custom Value SDG", sum(tot_cif_usd) "Custom Value USD",
sum("Number") "Number"
from
(SELECT ALL AWUNADM.EXPGRP.GRP G_Name, SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) tot_cif, 
SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_WGT_NET) "Net Mass KG",
ROUND(SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                           
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_usd, 
SUM(AWUNADM.SAD_SUPPLEMENTARY_UNIT.TAR_SUP_QTY) "Number"
FROM AWUNADM.GEN_ITEM_N_EXP, AWUNADM.EXPGRP, AWUNADM.N_UNTARTAB,AWUNADM.SAD_SUPPLEMENTARY_UNIT
WHERE (AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_EXP.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND SUBSTR(AWUNADM.GEN_ITEM_N_EXP.N_H6, 1, 4) NOT IN ('0407', '0409', '0508', '1701', '2505', '2517', '5201'))
 AND  ((AWUNADM.GEN_ITEM_N_EXP.N_H2=AWUNADM.EXPGRP.HS2(+))
 AND (AWUNADM.GEN_ITEM_N_EXP.N_H6=AWUNADM.N_UNTARTAB.N_T_H6))
AND (AWUNADM.GEN_ITEM_N_EXP.INSTANCEID=AWUNADM.SAD_SUPPLEMENTARY_UNIT.INSTANCEID(+))
AND (AWUNADM.GEN_ITEM_N_EXP.KEY_ITM_NBR=AWUNADM.SAD_SUPPLEMENTARY_UNIT.KEY_ITM_NBR(+))
GROUP BY AWUNADM.EXPGRP.GRP
union
SELECT ALL AWUNADM.EXPGRP.GRP, SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) tot_cif, 
SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_WGT_NET) "Net Mass KG",
ROUND(SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                           
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_usd, 
SUM(AWUNADM.SAD_SUPPLEMENTARY_UNIT.TAR_SUP_QTY) "Number"
FROM AWUNADM.GEN_ITEM_N_EXP, AWUNADM.EXPGRP, AWUNADM.N_UNTARTAB,AWUNADM.SAD_SUPPLEMENTARY_UNIT
WHERE (AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_EXP.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND SUBSTR(AWUNADM.GEN_ITEM_N_EXP.N_H6, 1, 4)  IN ('0407', '0409','1701','5201'))

 AND  ((decode(AWUNADM.GEN_ITEM_N_EXP.N_H2,AWUNADM.GEN_ITEM_N_EXP.N_H2,'10')=AWUNADM.EXPGRP.HS2(+))
 AND (AWUNADM.GEN_ITEM_N_EXP.N_H6=AWUNADM.N_UNTARTAB.N_T_H6))
AND (AWUNADM.GEN_ITEM_N_EXP.INSTANCEID=AWUNADM.SAD_SUPPLEMENTARY_UNIT.INSTANCEID(+))
AND (AWUNADM.GEN_ITEM_N_EXP.KEY_ITM_NBR=AWUNADM.SAD_SUPPLEMENTARY_UNIT.KEY_ITM_NBR(+))
GROUP BY AWUNADM.EXPGRP.GRP 
union
SELECT ALL AWUNADM.EXPGRP.GRP, SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) tot_cif, 
SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_WGT_NET) "Net Mass KG",
ROUND(SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                           
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_usd, 
SUM(AWUNADM.SAD_SUPPLEMENTARY_UNIT.TAR_SUP_QTY) "Number"
FROM AWUNADM.GEN_ITEM_N_EXP, AWUNADM.EXPGRP, AWUNADM.N_UNTARTAB,AWUNADM.SAD_SUPPLEMENTARY_UNIT
WHERE (AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_EXP.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND SUBSTR(AWUNADM.GEN_ITEM_N_EXP.N_H6, 1, 4)  IN ('0508'))

 AND  ((decode(AWUNADM.GEN_ITEM_N_EXP.N_H2,AWUNADM.GEN_ITEM_N_EXP.N_H2,'03')=AWUNADM.EXPGRP.HS2(+))
 AND (AWUNADM.GEN_ITEM_N_EXP.N_H6=AWUNADM.N_UNTARTAB.N_T_H6))
AND (AWUNADM.GEN_ITEM_N_EXP.INSTANCEID=AWUNADM.SAD_SUPPLEMENTARY_UNIT.INSTANCEID(+))
AND (AWUNADM.GEN_ITEM_N_EXP.KEY_ITM_NBR=AWUNADM.SAD_SUPPLEMENTARY_UNIT.KEY_ITM_NBR(+))
GROUP BY AWUNADM.EXPGRP.GRP 
union
SELECT ALL AWUNADM.EXPGRP.GRP, SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) tot_cif, 
SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_WGT_NET) "Net Mass KG",
ROUND(SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                           
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_usd, 
SUM(AWUNADM.SAD_SUPPLEMENTARY_UNIT.TAR_SUP_QTY) "Number"
FROM AWUNADM.GEN_ITEM_N_EXP, AWUNADM.EXPGRP, AWUNADM.N_UNTARTAB,AWUNADM.SAD_SUPPLEMENTARY_UNIT
WHERE (AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_EXP.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND SUBSTR(AWUNADM.GEN_ITEM_N_EXP.N_H6, 1, 4)  IN ('2505', '2517'))

 AND  ((decode(AWUNADM.GEN_ITEM_N_EXP.N_H2,AWUNADM.GEN_ITEM_N_EXP.N_H2,'26')=AWUNADM.EXPGRP.HS2(+))
 AND (AWUNADM.GEN_ITEM_N_EXP.N_H6=AWUNADM.N_UNTARTAB.N_T_H6))
AND (AWUNADM.GEN_ITEM_N_EXP.INSTANCEID=AWUNADM.SAD_SUPPLEMENTARY_UNIT.INSTANCEID(+))
AND (AWUNADM.GEN_ITEM_N_EXP.KEY_ITM_NBR=AWUNADM.SAD_SUPPLEMENTARY_UNIT.KEY_ITM_NBR(+))
GROUP BY AWUNADM.EXPGRP.GRP) all_exp_grp
group by all_exp_grp.G_Name]]>
	</queryString>
	<field name="G_NAME" class="java.lang.String"/>
	<field name="Net Mass KG" class="java.math.BigDecimal"/>
	<field name="Custom Value SDG" class="java.math.BigDecimal"/>
	<field name="Custom Value USD" class="java.math.BigDecimal"/>
