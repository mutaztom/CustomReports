<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BlackList" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="6318fe33-7d2f-48eb-a364-4c2291493744">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MutazHomeDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.util.Date">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="enddate" class="java.util.Date"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL AWUNADM.S043_TABLE.CONSIGNEE, AWUNADM.UNCMPTAB.CMP_NAM, SUM(AWUNADM.S043_TABLE.ALL_DATA) Cert_No, 
SUM(AWUNADM.S043_TABLE.COMPOUND_FEES) Tot_Com_Fees, 
NVL(AWUNADM.SEL_LISTS.LST_NAM, 'No List Found') LIST_Name, DECODE(AWUNADM.SEL_LISTS.LST_NAM, AWUNADM.SEL_LISTS.LST_NAM, NULL) "New List Name"
FROM AWUNADM.S043_TABLE, 
AWUNADM.UNCMPTAB, AWUNADM.SEL_LISTS_CMP, AWUNADM.SEL_LISTS
WHERE AWUNADM.S043_TABLE.COMPOUND_FEES<>0
AND AWUNADM.S043_TABLE.REG_DATE BETWEEN $P{startdate} AND $P{enddate}
 AND  ((AWUNADM.S043_TABLE.CONSIGNEE=AWUNADM.UNCMPTAB.CMP_COD)
 AND (AWUNADM.UNCMPTAB.CMP_COD=AWUNADM.SEL_LISTS_CMP.COD(+))
 AND (AWUNADM.SEL_LISTS_CMP.INSTANCE_ID=AWUNADM.SEL_LISTS.INSTANCE_ID(+)))
GROUP BY AWUNADM.S043_TABLE.CONSIGNEE, 
AWUNADM.UNCMPTAB.CMP_NAM, NVL(AWUNADM.SEL_LISTS.LST_NAM, 'No List Found'), 
DECODE(AWUNADM.SEL_LISTS.LST_NAM, AWUNADM.SEL_LISTS.LST_NAM, NULL)]]>
	</queryString>
	<field name="CONSIGNEE" class="java.lang.String"/>
	<field name="CMP_NAM" class="java.lang.String"/>
	<field name="CERT_NO" class="java.math.BigDecimal"/>
	<field name="TOT_COM_FEES" class="java.math.BigDecimal"/>
	<field name="LIST_NAME" class="java.lang.String"/>
	<field name="New List Name" class="java.lang.String"/>
	<sortField name="TOT_COM_FEES" order="Descending"/>
	<sortField name="LIST_NAME" order="Descending"/>
	<variable name="Count" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[$V{COLUMN_COUNT}]]></variableExpression>
	</variable>
