<!-- 2019-10-05T10:46:08 -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="IMDinvFull" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="415c292f-be35-4601-8e4a-66ed06483726">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01), 
0)) rate_n, 
AWUNADM.EXT_NAT_DESC.G_DESC, 
AWUNADM.SAD_TAX.TAX_LIN_RAT, SUM(AWUNADM.GEN_ITEM_N_2.VIT_WGT_NET) tot_wgt, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                            
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1)))tot_cif_usd, 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) tot_rel_loss
FROM AWUNADM.N_UNTARTAB, AWUNADM.EXT_NAT_DESC, 
AWUNADM.GEN_ITEM_N_2, AWUNADM.SAD_RELIEF, AWUNADM.SAD_TAX
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.SAD_RELIEF.TAX_CODE='IMD'
 AND AWUNADM.EXT_NAT_DESC.G_DESC='Investment'
 AND AWUNADM.SAD_TAX.TAX_LIN_COD='IMD'
 AND AWUNADM.N_UNTARTAB.TAR_T01<>'0'
 AND AWUNADM.SAD_TAX.TAX_LIN_AMT=0)
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.SAD_RELIEF.REL_CODE=AWUNADM.GEN_ITEM_N_2.TAR_PRC_NAT)
 AND (AWUNADM.GEN_ITEM_N_2.TAR_PRC_EXT=AWUNADM.EXT_NAT_DESC.EXT)
 AND (AWUNADM.GEN_ITEM_N_2.TAR_PRC_NAT=AWUNADM.EXT_NAT_DESC.NAT)
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR)
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR))
GROUP BY AWUNADM.EXT_NAT_DESC.G_DESC, TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01), 
0)), 
AWUNADM.SAD_TAX.TAX_LIN_RAT
ORDER BY TO_NUMBER(NVL(DECODE(AWUNADM.N_UNTARTAB.TAR_T01, 50, 40, AWUNADM.N_UNTARTAB.TAR_T01), 
0)) ASC]]>
	</queryString>
	<field name="RATE_N" class="java.math.BigDecimal"/>
	<field name="G_DESC" class="java.lang.String"/>
	<field name="TAX_LIN_RAT" class="java.math.BigDecimal"/>
	<field name="TOT_WGT" class="java.math.BigDecimal"/>
	<field name="TOT_CIF" class="java.math.BigDecimal"/>
	<field name="TOT_CIF_USD" class="java.math.BigDecimal"/>
	<field name="TOT_REL_LOSS" class="java.math.BigDecimal"/>
	<sortField name="RATE_N"/>
	<variable name="NetSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_WGT}]]></variableExpression>
	</variable>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF}]]></variableExpression>
	</variable>
	<variable name="USDSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF_USD}]]></variableExpression>
	</variable>
	<variable name="LossSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_REL_LOSS}]]></variableExpression>
	</variable>
	<variable name="TOT_CIF_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF}]]></variableExpression>
	</variable>
