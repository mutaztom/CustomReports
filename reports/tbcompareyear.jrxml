<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Trade balance compare prev." pageWidth="595" pageHeight="842" columnWidth="455" leftMargin="70" rightMargin="70" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" whenResourceMissingType="Key" uuid="8f5b312e-ad06-44c2-bb06-206ef15b4fc2">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.report.description" value="Trade balance compare prev."/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<template><![CDATA[System.getenv("CUSTREPDATA")+"/reports/rtstyle.jrtx"]]></template>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA["Vat Taxrate Analysis"]]></defaultValueExpression>
	</parameter>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[select table1."Month_Year", table1."Custom Value" "Export Value", table2."Custom Value" "Import Value",table1."Custom Value"-table2."Custom Value" Net
from
(
SELECT TO_CHAR($P{startdate}, 'MON ')||TO_CHAR($P{startdate}, 'YYYY')||' TO '||TO_CHAR($P{enddate}, 'MON ')||TO_CHAR($P{enddate}, 'YYYY') "Month_Year",
SUM(AWUNADM.SAD_ITEM.VIT_CIF/DECODE(AWUNADM.SAD_ITEM.VIT_INV_CUR_RAT, AWUNADM.SAD_ITEM.VIT_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 

                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) "Custom Value" 
FROM AWUNADM.SAD_GENERAL_SEGMENT, AWUNADM.SAD_ITEM
WHERE (AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC=1
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_NBR IS NOT NULL
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_SER IS NOT NULL)
 AND  (AWUNADM.SAD_GENERAL_SEGMENT.INSTANCEID=AWUNADM.SAD_ITEM.INSTANCEID(+))
GROUP BY 
TO_CHAR(AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT, 'YYYY')
) table1,
(
SELECT  TO_CHAR($P{startdate}, 'MON ')||TO_CHAR($P{startdate}, 'YYYY')||' TO '||TO_CHAR($P{enddate}, 'MON ')||TO_CHAR($P{enddate}, 'YYYY') "Month_Year",
 
SUM(AWUNADM.SAD_ITEM.VIT_CIF/DECODE(AWUNADM.SAD_ITEM.VIT_INV_CUR_RAT, AWUNADM.SAD_ITEM.VIT_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 

                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) "Custom Value" 
FROM AWUNADM.SAD_GENERAL_SEGMENT, AWUNADM.SAD_ITEM
WHERE (AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC=4
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_NBR IS NOT NULL
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_SER IS NOT NULL)
 AND  (AWUNADM.SAD_GENERAL_SEGMENT.INSTANCEID=AWUNADM.SAD_ITEM.INSTANCEID(+))
GROUP BY 
TO_CHAR(AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT, 'YYYY')
) table2
where table1."Month_Year" = table2."Month_Year"
union 
select table1."Month_Year", table1."Custom Value" "Export Value", table2."Custom Value" "Import Value",table1."Custom Value"-table2."Custom Value" Net
from
(
SELECT  TO_CHAR($P{startdate}-365, 'MON ')||TO_CHAR($P{startdate}-365, 'YYYY')||' TO '||TO_CHAR($P{enddate}-365, 'MON ')||TO_CHAR($P{enddate}-365, 'YYYY') "Month_Year",
SUM(AWUNADM.SAD_ITEM.VIT_CIF/DECODE(AWUNADM.SAD_ITEM.VIT_INV_CUR_RAT, AWUNADM.SAD_ITEM.VIT_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 

                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate}-365)
and rownum=1))) "Custom Value" 
FROM AWUNADM.SAD_GENERAL_SEGMENT, AWUNADM.SAD_ITEM
WHERE (AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC=1
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT BETWEEN $P{startdate}-365 AND $P{enddate}-365
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_NBR IS NOT NULL
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_SER IS NOT NULL)
 AND  (AWUNADM.SAD_GENERAL_SEGMENT.INSTANCEID=AWUNADM.SAD_ITEM.INSTANCEID(+))
GROUP BY 
TO_CHAR(AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT, 'YYYY') 
) table1,
(
SELECT   TO_CHAR($P{startdate}-365, 'MON ')||TO_CHAR($P{startdate}-365, 'YYYY')||' TO '||TO_CHAR($P{enddate}-365, 'MON ')||TO_CHAR($P{enddate}-365, 'YYYY') "Month_Year", 
SUM(AWUNADM.SAD_ITEM.VIT_CIF/DECODE(AWUNADM.SAD_ITEM.VIT_INV_CUR_RAT, AWUNADM.SAD_ITEM.VIT_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 

                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
and AWCURUPDATE_GEN.VDAT <$P{enddate}-365)
and rownum=1))) "Custom Value" 
FROM AWUNADM.SAD_GENERAL_SEGMENT, AWUNADM.SAD_ITEM
WHERE (AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC=4
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT BETWEEN $P{startdate}-365 AND $P{enddate}-365
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_NBR IS NOT NULL
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_SER IS NOT NULL)
 AND  (AWUNADM.SAD_GENERAL_SEGMENT.INSTANCEID=AWUNADM.SAD_ITEM.INSTANCEID(+))
GROUP BY 
TO_CHAR(AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT, 'YYYY')
) table2
where table1."Month_Year" = table2."Month_Year"]]>
	</queryString>
	<field name="Month_Year" class="java.lang.String"/>
	<field name="Export Value" class="java.math.BigDecimal"/>
	<field name="Import Value" class="java.math.BigDecimal"/>
	<field name="NET" class="java.math.BigDecimal"/>
