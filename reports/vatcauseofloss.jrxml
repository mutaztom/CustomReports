			<staticText>
				<reportElement style="rtstyle" mode="Opaque" x="463" y="0" width="45" height="20" backcolor="#DBD7D7" uuid="5b7586c7-a8b7-431a-8628-986ae2659bd2">
					<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="d89537df-900d-462f-b86f-da411a0286b2"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
