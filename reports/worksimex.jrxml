<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="works" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="d381e010-4197-4aba-a370-d07c462f200c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="Code" class="java.lang.String"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_NBR||' / '||AWUNADM.SAD_ITEM.KEY_ITM_NBR decno, 
DECODE(AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC, 1, 'EX', 4, 'IM') IM_EX, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_CUO_COD, 
SUBSTR(AWUNADM.SAD_ITEM.TAR_HSC_NB1||AWUNADM.SAD_ITEM.TAR_HSC_NB2, 1, 8) Comm_Code, 
AWUNADM.SAD_ITEM.VIT_CIF, AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT CPC, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_NBR,
AWUNADM.SAD_ITEM.TAX_AMT+25 tot_duty_25, 
SAD_TAX_A1.TAX_LIN_AMT BPT, 
AWUNADM.SAD_TAX.TAX_LIN_AMT VAT, 
AWUNADM.SAD_GENERAL_SEGMENT.DEC_COD BROK, 
AWUNADM.UNCMPTAB.CMP_NAM
FROM AWUNADM.SAD_GENERAL_SEGMENT, AWUNADM.SAD_ITEM, 
AWUNADM.UNCMPTAB, AWUNADM.SAD_TAX, AWUNADM.SAD_TAX SAD_TAX_A1
WHERE (AWUNADM.SAD_GENERAL_SEGMENT.SAD_STA<>'D'
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}

 AND AWUNADM.SAD_GENERAL_SEGMENT.CMP_CON_COD=$P{Code}
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC IN (1, 4)
AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_CUO_COD NOT LIKE 'EXC%'
AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_CUO_COD <> 'GIAD0'
 AND SAD_TAX_A1.TAX_LIN_COD='BPT'
 AND AWUNADM.SAD_TAX.TAX_LIN_COD='VAT')
 AND  ((AWUNADM.SAD_GENERAL_SEGMENT.INSTANCEID=AWUNADM.SAD_ITEM.INSTANCEID(+))
 AND (AWUNADM.SAD_GENERAL_SEGMENT.CMP_CON_COD=AWUNADM.UNCMPTAB.CMP_COD)
 AND (AWUNADM.SAD_ITEM.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID)
 AND (AWUNADM.SAD_ITEM.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR)
 AND (AWUNADM.SAD_ITEM.INSTANCEID=SAD_TAX_A1.INSTANCEID)
 AND (AWUNADM.SAD_ITEM.KEY_ITM_NBR=SAD_TAX_A1.KEY_ITM_NBR))
union 
SELECT ALL AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_NBR||' / '||AWUNADM.SAD_ITEM.KEY_ITM_NBR decno, 
DECODE(AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC, 1, 'EX', 4, 'IM') IM_EX, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_CUO_COD, 
SUBSTR(AWUNADM.SAD_ITEM.TAR_HSC_NB1||AWUNADM.SAD_ITEM.TAR_HSC_NB2, 1, 8) Comm_Code, 
AWUNADM.SAD_ITEM.VIT_CIF, AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT CPC, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_NBR,
AWUNADM.SAD_ITEM.TAX_AMT+25 tot_duty_25,
0.00,
0.00,
AWUNADM.SAD_GENERAL_SEGMENT.DEC_COD,
 AWUNADM.UNCMPTAB.CMP_NAM
FROM AWUNADM.SAD_GENERAL_SEGMENT, AWUNADM.SAD_ITEM, AWUNADM.UNCMPTAB
WHERE (AWUNADM.SAD_GENERAL_SEGMENT.SAD_STA<>'D'
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}

 AND AWUNADM.SAD_GENERAL_SEGMENT.CMP_EXP_COD=$P{Code}
  AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_SER not in ('P','B','T')
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC IN (1, 4))
AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_CUO_COD NOT LIKE 'EXC%'
AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_CUO_COD <> 'GIAD0'
 AND  ((AWUNADM.SAD_GENERAL_SEGMENT.INSTANCEID=AWUNADM.SAD_ITEM.INSTANCEID(+))
 AND (AWUNADM.SAD_GENERAL_SEGMENT.CMP_EXP_COD=AWUNADM.UNCMPTAB.CMP_COD))]]>
	</queryString>
	<field name="DECNO" class="java.lang.String"/>
	<field name="IM_EX" class="java.lang.String"/>
	<field name="IDE_CUO_COD" class="java.lang.String"/>
	<field name="COMM_CODE" class="java.lang.String"/>
