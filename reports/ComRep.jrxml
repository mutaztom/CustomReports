	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL AWUNADM.GEN_ITEM_N_2.IDE_CUO_COD, AWUNADM.GEN_ITEM_N_2.IDE_CUO_NAM, 
SUBSTR(AWUNADM.GEN_ITEM_N_2.N_H6, 1, 8) N_H8, SUM(AWUNADM.GEN_ITEM_N_2.VIT_WGT_NET) tot_wgt, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, 
COUNT(AWUNADM.GEN_ITEM_N_2.INSTANCEID) No_Cert
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB
WHERE AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND  (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6)
GROUP BY AWUNADM.GEN_ITEM_N_2.INSTANCEID, 
AWUNADM.GEN_ITEM_N_2.IDE_CUO_COD, AWUNADM.GEN_ITEM_N_2.IDE_CUO_NAM, AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, 
SUBSTR(AWUNADM.GEN_ITEM_N_2.N_H6, 1, 8)]]>
	</queryString>
