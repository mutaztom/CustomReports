<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ExportCom" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="413faf04-fe0e-4352-87e8-b7e5ec06dd99">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL SUBSTR(AWUNADM.GEN_ITEM_N_EXP.TAR_HSC_NB1, 1, 4) HSB_NB14, 
AWUNADM.GEN_ITEM_N_EXP.TAR_HSC_NB1, AWUNADM.N_UNTARTAB.TAR_DSC, SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_WGT_NET) "Net Mass KG", 
ROUND(SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_EXP.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                           
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_usd, 
SUM(AWUNADM.GEN_ITEM_N_EXP.PCK_NBR) "Number"
FROM AWUNADM.GEN_ITEM_N_EXP, AWUNADM.SAD_SUPPLEMENTARY_UNIT, AWUNADM.N_UNTARTAB
WHERE (AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_EXP.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND (AWUNADM.GEN_ITEM_N_EXP.INSTANCEID=AWUNADM.SAD_SUPPLEMENTARY_UNIT.INSTANCEID(+))
 AND (AWUNADM.GEN_ITEM_N_EXP.KEY_ITM_NBR=AWUNADM.SAD_SUPPLEMENTARY_UNIT.KEY_ITM_NBR(+))
 AND (AWUNADM.GEN_ITEM_N_EXP.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
GROUP BY SUBSTR(AWUNADM.GEN_ITEM_N_EXP.TAR_HSC_NB1, 1, 4), 
AWUNADM.GEN_ITEM_N_EXP.TAR_HSC_NB1, AWUNADM.N_UNTARTAB.TAR_DSC
ORDER BY SUBSTR(AWUNADM.GEN_ITEM_N_EXP.TAR_HSC_NB1, 1, 4) ASC]]>
	</queryString>
	<field name="HSB_NB14" class="java.lang.String"/>
	<field name="TAR_HSC_NB1" class="java.lang.String"/>
	<field name="TAR_DSC" class="java.lang.String"/>
	<field name="Net Mass KG" class="java.math.BigDecimal"/>
	<field name="TOT_CIF_USD" class="java.math.BigDecimal"/>
	<field name="Number" class="java.math.BigDecimal"/>
