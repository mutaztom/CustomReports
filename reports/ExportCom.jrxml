		<variableExpression><![CDATA[$F{Net Mass KG}]]></variableExpression>
	</variable>
	<variable name="USDSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF_USD}]]></variableExpression>
	</variable>
	<variable name="NumSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
