<!-- 2019-10-05T11:04:59 -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ADT ZERO RATED ANALYSIS" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="28cac796-479d-4843-985c-638c7eab42bc">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<template><![CDATA[System.getenv("CUSTREPDATA")+"/reports/rtstyle.jrtx"]]></template>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{JASPER_REPORT}.getName()]]></defaultValueExpression>
	</parameter>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT ALL TO_NUMBER(NVL(AWUNADM.N_UNTARTAB.TAR_T02, 0)) "Rate", 
SUBSTR(AWUNADM.N_UNTARTAB.N_T_H6, 1, 8) "HS Code", 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_WGT_NET) "Net Mass (Kg)", SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) "Custom Value (SDG)", 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                          
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))) "Custom Value (USD)"
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB
WHERE (AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND NVL(TO_NUMBER(AWUNADM.N_UNTARTAB.TAR_T02), 0)=0)
 AND  (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
GROUP BY SUBSTR(AWUNADM.N_UNTARTAB.N_T_H6, 1, 8), 
TO_NUMBER(NVL(AWUNADM.N_UNTARTAB.TAR_T02, 0))]]>
	</queryString>
	<field name="Rate" class="java.math.BigDecimal"/>
	<field name="HS Code" class="java.lang.String"/>
	<field name="Net Mass (Kg)" class="java.math.BigDecimal"/>
	<field name="Custom Value (SDG)" class="java.math.BigDecimal"/>
	<field name="Custom Value (USD)" class="java.math.BigDecimal"/>
	<variable name="USDSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (USD)}]]></variableExpression>
	</variable>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}]]></variableExpression>
	</variable>
	<variable name="NetSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Net Mass (Kg)}]]></variableExpression>
	</variable>
	<variable name="Custom Value (SDG)_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value (SDG)}]]></variableExpression>
	</variable>
