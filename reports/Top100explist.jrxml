<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Top100explist" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="73a9000b-d35e-4940-a76c-1b3d9ffb4ead">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Test"/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[select top_exp.CMP_COD,top_exp.CMP_NAM,top_exp.tot_cif,top_exp.cnt,top_exp.LST_NAM
from 
(SELECT ALL AWUNADM.UNCMPTAB.CMP_COD CMP_COD, 
AWUNADM.UNCMPTAB.CMP_NAM CMP_NAM, SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) tot_cif, 
COUNT(DISTINCT AWUNADM.GEN_ITEM_N_EXP.INSTANCEID) cnt,
AWUNADM.SEL_LISTS.LST_NAM LST_NAM
FROM AWUNADM.GEN_ITEM_N_EXP, AWUNADM.N_UNTARTAB, AWUNADM.UNCMPTAB
,AWUNADM.SEL_LISTS_CMP, AWUNADM.SEL_LISTS
WHERE (AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_EXP.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_EXP.N_H6=AWUNADM.N_UNTARTAB.N_T_H6)
 AND (AWUNADM.GEN_ITEM_N_EXP.CMP_EXP_COD=AWUNADM.UNCMPTAB.CMP_COD)
AND (AWUNADM.UNCMPTAB.CMP_COD=AWUNADM.SEL_LISTS_CMP.COD(+))
 AND (AWUNADM.SEL_LISTS_CMP.INSTANCE_ID=AWUNADM.SEL_LISTS.INSTANCE_ID))
GROUP BY AWUNADM.UNCMPTAB.CMP_COD, AWUNADM.UNCMPTAB.CMP_NAM,AWUNADM.SEL_LISTS.LST_NAM
ORDER BY SUM(AWUNADM.GEN_ITEM_N_EXP.VIT_CIF) DESC) top_exp
where rownum<101]]>
	</queryString>
	<field name="CMP_COD" class="java.lang.String"/>
	<field name="CMP_NAM" class="java.lang.String"/>
	<field name="TOT_CIF" class="java.math.BigDecimal"/>
	<field name="CNT" class="java.math.BigDecimal"/>
	<field name="LST_NAM" class="java.lang.String"/>
	<sortField name="TOT_CIF" order="Descending"/>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF}]]></variableExpression>
	</variable>
	<variable name="CountSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CNT}]]></variableExpression>
	</variable>
	<variable name="Rows" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[$V{COLUMN_COUNT}]]></variableExpression>
	</variable>
