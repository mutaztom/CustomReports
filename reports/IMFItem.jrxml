<!-- 2019-10-05T13:51:09 -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="IMFItem" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" isFloatColumnFooter="true" uuid="7565e589-886e-4411-b924-9f1255636848">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[select com_grp2_imd2.G_Name "Group Name",com_grp2_imd2.Item_desc "Item Description",com_grp2_imd2.tot_wgt "Net Mass KG",
com_grp2_imd2.tot_cif "Custom Value SDG",com_grp2_imd2.tot_cif_usd "Custom Value USD",com_grp2_imd2.tot_imd "Import Duty SDG",
other_taxes.other_tax "Others Taxes SDG"
from (select com_grp1.G_Name G_Name,com_grp1.Item_desc Item_desc,com_grp1.tot_wgt tot_wgt,com_grp1.tot_cif tot_cif,com_grp1.tot_cif_usd tot_cif_usd,
cop_grp2_imd.tot_imd tot_imd
from
(SELECT ALL NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') G_Name,NVL(AWUNADM.N_COMGRP.GRP_NAM,' Others item') Item_desc, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_WGT_NET) tot_wgt, SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, 
ROUND(SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                          
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) tot_cif_usd
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.N_COMGRP
WHERE AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G(+)))
GROUP BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others'),
NVL(AWUNADM.N_COMGRP.GRP_NAM,' Others item')
ORDER BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') DESC) com_grp1,(SELECT ALL NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') G_Name,NVL(AWUNADM.N_COMGRP.GRP_NAM,' Others item') Item_desc,
SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) tot_imd
FROM AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.N_COMGRP, AWUNADM.SAD_TAX
WHERE (AWUNADM.SAD_TAX.TAX_LIN_COD='IMD'
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR))
GROUP BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others'),
NVL(AWUNADM.N_COMGRP.GRP_NAM,' Others item')
ORDER BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') DESC) cop_grp2_imd
where com_grp1.G_Name=cop_grp2_imd.G_Name
and  com_grp1.Item_desc=cop_grp2_imd.Item_desc
order by 1 desc) com_grp2_imd2,(select com_grp_vat.G_Name G_Name,com_grp_vat.Item_desc Item_desc,com_grp_vat.tot_vat+com_grp_adt.tot_adt other_tax
from
(SELECT ALL NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') G_Name,NVL(AWUNADM.N_COMGRP.GRP_NAM,' Others item') Item_desc, 
SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) tot_vat
FROM AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.N_COMGRP, AWUNADM.SAD_TAX
WHERE (AWUNADM.SAD_TAX.TAX_LIN_COD='VAT'
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR))
GROUP BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others'),
NVL(AWUNADM.N_COMGRP.GRP_NAM,' Others item') 
ORDER BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') DESC) com_grp_vat,
(SELECT ALL NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') G_Name, NVL(AWUNADM.N_COMGRP.GRP_NAM,' Others item') Item_desc,
SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) tot_ADT
FROM AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.N_COMGRP, AWUNADM.SAD_TAX
WHERE (AWUNADM.SAD_TAX.TAX_LIN_COD='ADT'
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR))
GROUP BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others'),
NVL(AWUNADM.N_COMGRP.GRP_NAM,' Others item')
ORDER BY NVL(AWUNADM.N_COMGRP.COM_GRP, ' Others') DESC) com_grp_adt
where com_grp_vat.G_Name=com_grp_adt.G_Name
and com_grp_vat.Item_desc=com_grp_adt.Item_desc) other_taxes
where com_grp2_imd2.G_Name=other_taxes.G_Name
and com_grp2_imd2.Item_desc=other_taxes.Item_desc]]>
	</queryString>
