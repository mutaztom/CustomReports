	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL SUBSTR(AWUNADM.GEN_ITEM_N_2.N_H6, 1, 8) N_H8, 
AWUNADM.N_UNTARTAB.TAR_DSC, COUNT(AWUNADM.GEN_ITEM_N_2.INSTANCEID) No_Cert, 
SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) tot_cif, AWUNADM.TAX_AMT.TOT_AMT
FROM AWUNADM.GEN_ITEM_N_2, AWUNADM.N_UNTARTAB, AWUNADM.TAX_AMT
WHERE AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6)
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.TAX_AMT.INSTANCEID))
GROUP BY SUBSTR(AWUNADM.GEN_ITEM_N_2.N_H6, 1, 8), 
AWUNADM.N_UNTARTAB.TAR_DSC, AWUNADM.TAX_AMT.TOT_AMT]]>
	</queryString>
	<field name="N_H8" class="java.lang.String"/>
	<field name="TAR_DSC" class="java.lang.String"/>
	<field name="NO_CERT" class="java.math.BigDecimal"/>
	<field name="TOT_CIF" class="java.math.BigDecimal"/>
	<field name="TOT_AMT" class="java.math.BigDecimal"/>
	<sortField name="TOT_CIF" order="Descending"/>
	<sortField name="N_H8" order="Descending"/>
	<variable name="SDGSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF}]]></variableExpression>
	</variable>
	<variable name="DutySum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_AMT}]]></variableExpression>
	</variable>
	<variable name="FormSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{NO_CERT}]]></variableExpression>
	</variable>
	<variable name="SDGSum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_CIF}]]></variableExpression>
	</variable>
	<variable name="DutySum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_AMT}]]></variableExpression>
	</variable>
	<variable name="FormSum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{NO_CERT}]]></variableExpression>
	</variable>
