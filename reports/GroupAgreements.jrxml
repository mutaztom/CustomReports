<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GroupAgreements" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="c406931a-d68f-4057-9465-0fb99dc83f8b">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL AWUNADM.GEN_ITEM_N_2.TAR_PRF "Perfrence", 
AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY "Orginal Country", SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF) "Custom Value SDG", 
ROUND(SUM(AWUNADM.GEN_ITEM_N_2.VIT_CIF/DECODE(AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, 
AWUNADM.GEN_ITEM_N_2.VGS_INV_CUR_RAT, (select 
                            AWCURUPDATE_ITM.CUR_NRAT  CUR_NRAT
                                        from    
                                         AWUNADM.AWCURUPDATE_ITM,
                                         AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'
                              and AWCURUPDATE_GEN.VDAT =
                                 (select 
                    
                              max(AWCURUPDATE_GEN.VDAT) MVDAT
                            
                            from    
                             AWUNADM.AWCURUPDATE_ITM,
                             AWUNADM.AWCURUPDATE_GEN
                            Where    
                              AWCURUPDATE_ITM.INSTANCE_ID = AWCURUPDATE_GEN.INSTANCE_ID 
                              and AWCURUPDATE_ITM.CUR_COD ='USD'

and AWCURUPDATE_GEN.VDAT <$P{enddate})
and rownum=1))), 2) "Custom Value USD", 
SUM(AWUNADM.SAD_RELIEF.TAX_AMOUNT) "Losses SDG", AWUNADM.N_COMGRP.GRP_NAM "Group Name"
FROM AWUNADM.GEN_ITEM_N_2, 
AWUNADM.N_UNTARTAB, AWUNADM.SAD_RELIEF, AWUNADM.N_COMGRP
WHERE (AWUNADM.GEN_ITEM_N_2.TAR_PRF IN ('COMESA', 'ARU')
 AND AWUNADM.N_UNTARTAB.VALID_TO IS NULL
 AND AWUNADM.GEN_ITEM_N_2.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_UNTARTAB.N_T_H6(+))
 AND (AWUNADM.GEN_ITEM_N_2.INSTANCEID=AWUNADM.SAD_RELIEF.INSTANCEID)
 AND (AWUNADM.GEN_ITEM_N_2.KEY_ITM_NBR=AWUNADM.SAD_RELIEF.KEY_ITM_NBR)
 AND (AWUNADM.GEN_ITEM_N_2.N_H6=AWUNADM.N_COMGRP.N_H6_G))
GROUP BY AWUNADM.GEN_ITEM_N_2.TAR_PRF, 
AWUNADM.GEN_ITEM_N_2.GDS_ORG_CTY, AWUNADM.N_COMGRP.GRP_NAM
ORDER BY AWUNADM.GEN_ITEM_N_2.TAR_PRF ASC]]>
	</queryString>
	<field name="Perfrence" class="java.lang.String"/>
	<field name="Orginal Country" class="java.lang.String"/>
	<field name="Custom Value SDG" class="java.math.BigDecimal"/>
	<field name="Custom Value USD" class="java.math.BigDecimal"/>
	<field name="Losses SDG" class="java.math.BigDecimal"/>
	<field name="Group Name" class="java.lang.String"/>
	<sortField name="Perfrence" order="Descending"/>
	<variable name="SDGSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value SDG}]]></variableExpression>
	</variable>
	<variable name="USDSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value USD}]]></variableExpression>
	</variable>
	<variable name="LossSum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group1" calculation="Sum">
		<variableExpression><![CDATA[$F{Losses SDG}]]></variableExpression>
	</variable>
	<variable name="Losses SDG_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Losses SDG}]]></variableExpression>
	</variable>
	<variable name="Custom Value SDG_SUM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value SDG}]]></variableExpression>
	</variable>
	<variable name="SDGSum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value SDG}]]></variableExpression>
	</variable>
	<variable name="USDSum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Custom Value USD}]]></variableExpression>
	</variable>
	<variable name="LossSum2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Losses SDG}]]></variableExpression>
	</variable>
