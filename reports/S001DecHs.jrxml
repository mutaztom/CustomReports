<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="S001DecHs" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="4d94a933-b700-4f9e-898f-9af73ef32e03">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Test"/>
	<template><![CDATA[System.getenv("CUSTREPDATA")+"/reports/rtstyle.jrtx"]]></template>
	<parameter name="Station" class="java.lang.String"/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="List_1" class="java.lang.String"/>
	<parameter name="List_2" class="java.lang.String"/>
	<parameter name="List_3" class="java.lang.String"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL AWUNADM.S001_TABLE.DECLARANT, COUNT(AWUNADM.S001_TABLE.OLD_HSCOD) cnt, SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5) Station, 
AWUNADM.UNDECTAB.DEC_NAM, NVL(AWUNADM.SEL_LISTS.LST_NAM, ' Not Found in any LIST') "N_LST Name", 
DECODE(AWUNADM.SEL_LISTS.LST_NAM, AWUNADM.SEL_LISTS.LST_NAM, ' DEC-CLS-SUB1') "New List"
FROM AWUNADM.S001_TABLE, 
AWUNADM.MAX_INSTANCE_DEC, AWUNADM.SEL_LISTS, AWUNADM.UNDECTAB
WHERE (AWUNADM.S001_TABLE.OLD_HSCOD<>NVL(AWUNADM.S001_TABLE.NEW_HSCOD, 0)
 AND SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5)=NVL($P{Station}, SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5))
 AND AWUNADM.S001_TABLE.ASS_DATE BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.S001_TABLE.DECLARANT=AWUNADM.MAX_INSTANCE_DEC.COD(+))
 AND (AWUNADM.MAX_INSTANCE_DEC.M_INSTANCE=AWUNADM.SEL_LISTS.INSTANCE_ID(+))
 AND (AWUNADM.S001_TABLE.DECLARANT=AWUNADM.UNDECTAB.DEC_COD))
GROUP BY SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5), 
AWUNADM.S001_TABLE.DECLARANT, AWUNADM.UNDECTAB.DEC_NAM, 
NVL(AWUNADM.SEL_LISTS.LST_NAM, ' Not Found in any LIST'), DECODE(AWUNADM.SEL_LISTS.LST_NAM, AWUNADM.SEL_LISTS.LST_NAM, ' DEC-CLS-SUB1')
HAVING COUNT(AWUNADM.S001_TABLE.OLD_HSCOD) BETWEEN $P{List_1} AND $P{List_2}-1
--ORDER BY COUNT(AWUNADM.S001_TABLE.OLD_HSCOD) DESC
union
SELECT ALL AWUNADM.S001_TABLE.DECLARANT, COUNT(AWUNADM.S001_TABLE.OLD_HSCOD) cnt, SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5) Station, 
AWUNADM.UNDECTAB.DEC_NAM, NVL(AWUNADM.SEL_LISTS.LST_NAM, ' Not Found in any LIST') "N_LST Name", 
DECODE(AWUNADM.SEL_LISTS.LST_NAM, AWUNADM.SEL_LISTS.LST_NAM, ' DEC-CLS-SUB2') "New List"
FROM AWUNADM.S001_TABLE, 
AWUNADM.MAX_INSTANCE_DEC, AWUNADM.SEL_LISTS, AWUNADM.UNDECTAB
WHERE (AWUNADM.S001_TABLE.OLD_HSCOD<>NVL(AWUNADM.S001_TABLE.NEW_HSCOD, 0)
 AND SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5)=NVL($P{Station}, SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5))
 AND AWUNADM.S001_TABLE.ASS_DATE BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.S001_TABLE.DECLARANT=AWUNADM.MAX_INSTANCE_DEC.COD(+))
 AND (AWUNADM.MAX_INSTANCE_DEC.M_INSTANCE=AWUNADM.SEL_LISTS.INSTANCE_ID(+))
 AND (AWUNADM.S001_TABLE.DECLARANT=AWUNADM.UNDECTAB.DEC_COD))
GROUP BY SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5), 
AWUNADM.S001_TABLE.DECLARANT, AWUNADM.UNDECTAB.DEC_NAM, 
NVL(AWUNADM.SEL_LISTS.LST_NAM, ' Not Found in any LIST'), DECODE(AWUNADM.SEL_LISTS.LST_NAM, AWUNADM.SEL_LISTS.LST_NAM, ' DEC-CLS-SUB2')
HAVING COUNT(AWUNADM.S001_TABLE.OLD_HSCOD) BETWEEN $P{List_2} AND $P{List_3}-1
union
SELECT ALL AWUNADM.S001_TABLE.DECLARANT, COUNT(AWUNADM.S001_TABLE.OLD_HSCOD) cnt, SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5) Station, 
AWUNADM.UNDECTAB.DEC_NAM, NVL(AWUNADM.SEL_LISTS.LST_NAM, ' Not Found in any LIST') "N_LST Name", 
DECODE(AWUNADM.SEL_LISTS.LST_NAM, AWUNADM.SEL_LISTS.LST_NAM, ' DEC-CLS-SUB3') "New List"
FROM AWUNADM.S001_TABLE, 
AWUNADM.MAX_INSTANCE_DEC, AWUNADM.SEL_LISTS, AWUNADM.UNDECTAB
WHERE (AWUNADM.S001_TABLE.OLD_HSCOD<>NVL(AWUNADM.S001_TABLE.NEW_HSCOD, 0)
 AND SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5)=NVL($P{Station}, SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5))
 AND AWUNADM.S001_TABLE.ASS_DATE BETWEEN $P{startdate} AND $P{enddate})
 AND  ((AWUNADM.S001_TABLE.DECLARANT=AWUNADM.MAX_INSTANCE_DEC.COD(+))
 AND (AWUNADM.MAX_INSTANCE_DEC.M_INSTANCE=AWUNADM.SEL_LISTS.INSTANCE_ID(+))
 AND (AWUNADM.S001_TABLE.DECLARANT=AWUNADM.UNDECTAB.DEC_COD))
GROUP BY SUBSTR(AWUNADM.S001_TABLE.SAD_NBR, 1, 5), 
AWUNADM.S001_TABLE.DECLARANT, AWUNADM.UNDECTAB.DEC_NAM, 
NVL(AWUNADM.SEL_LISTS.LST_NAM, ' Not Found in any LIST'), DECODE(AWUNADM.SEL_LISTS.LST_NAM, AWUNADM.SEL_LISTS.LST_NAM, ' DEC-CLS-SUB3')
HAVING COUNT(AWUNADM.S001_TABLE.OLD_HSCOD) BETWEEN $P{List_3} AND $P{List_3}+1000
order by 2 desc]]>
	</queryString>
