	<field name="IDE_RCP_NBR" class="java.lang.String"/>
	<field name="TOT_DUTIES" class="java.math.BigDecimal"/>
	<field name="DEC_NAM" class="java.lang.String"/>
	<field name="PERSONAL" class="java.math.BigDecimal"/>
