<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="worksdec" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="4b33de4f-6d56-4740-afd9-ff59175a0271">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportsDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startdate" class="java.sql.Date"/>
	<parameter name="enddate" class="java.sql.Date"/>
	<parameter name="code" class="java.lang.String"/>
	<parameter name="title" class="java.lang.String"/>
	<parameter name="repstartdate" class="java.lang.String"/>
	<parameter name="rependdate" class="java.lang.String"/>
	<parameter name="username" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_NBR, 
AWUNADM.SAD_ITEM.KEY_ITM_NBR, DECODE(AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC, 1, 'EX', 4, 'IM') IM_EX, 
AWUNADM.SAD_GENERAL_SEGMENT.TPT_CUO_COD, 
SUBSTR(AWUNADM.SAD_ITEM.TAR_HSC_NB1||AWUNADM.SAD_ITEM.TAR_HSC_NB2, 1, 8) Comm_Code, 
AWUNADM.SAD_ITEM.VIT_CIF, AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT CPC, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_NBR, SUM(AWUNADM.SAD_TAX.TAX_LIN_AMT) tot_duties, 
AWUNADM.UNDECTAB.DEC_NAM, DECODE(AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_SER, 'P', 1, 0) personal, 
DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'4000.000', 1, 0) comm, 
TO_NUMBER(DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'1000.041', 0, '1000.000', 0, 1))*TO_NUMBER(DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'1000.041', 0, '1000.000', 0, '2000.000', 0, 
'3000.000', 0, '4000.000', '0', '4000.006', 0, '4000.042', 0, 1)) other, 
DECODE(AWUNADM.SAD_ITEM.KEY_ITM_NBR, 1, 1, 0) Cert_No, 
DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'1000.041', 1, '1000.000', 1, '2000.000', 1, '3000.000', 1, 0) Exports, 
DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'4000.042', 1, 0) Deplomatics, 
DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'4000.072', 1, 0) Withdrawls, 
DECODE(SUBSTR(AWUNADM.SAD_ITEM.TAR_PRC_EXT, 1, 1), 7, 1, 8, 1, 0) Bill_Trans, 
DECODE(AWUNADM.SAD_ITEM.KEY_ITM_NBR, AWUNADM.SAD_ITEM.KEY_ITM_NBR, 1) Item_No
FROM AWUNADM.SAD_GENERAL_SEGMENT, 
AWUNADM.SAD_ITEM, AWUNADM.SAD_TAX, AWUNADM.UNDECTAB
WHERE (AWUNADM.SAD_GENERAL_SEGMENT.SAD_STA<>'D'
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT BETWEEN $P{startdate} AND $P{enddate}
 AND AWUNADM.SAD_GENERAL_SEGMENT.DEC_COD=$P{code}
 AND AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC IN (1, 4))
 AND  ((AWUNADM.SAD_GENERAL_SEGMENT.INSTANCEID=AWUNADM.SAD_ITEM.INSTANCEID(+))
 AND (AWUNADM.SAD_ITEM.INSTANCEID=AWUNADM.SAD_TAX.INSTANCEID(+))
 AND (AWUNADM.SAD_ITEM.KEY_ITM_NBR=AWUNADM.SAD_TAX.KEY_ITM_NBR(+))
 AND (AWUNADM.SAD_GENERAL_SEGMENT.DEC_COD=AWUNADM.UNDECTAB.DEC_COD))
GROUP BY AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_NBR, AWUNADM.SAD_ITEM.KEY_ITM_NBR, 
DECODE(AWUNADM.SAD_GENERAL_SEGMENT.IDE_TYP_PRC, 1, 'EX', 4, 'IM'), 
AWUNADM.SAD_GENERAL_SEGMENT.TPT_CUO_COD, SUBSTR(AWUNADM.SAD_ITEM.TAR_HSC_NB1||AWUNADM.SAD_ITEM.TAR_HSC_NB2, 1, 8), 
AWUNADM.SAD_ITEM.VIT_CIF, AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_DAT, 
AWUNADM.SAD_GENERAL_SEGMENT.IDE_RCP_NBR, AWUNADM.UNDECTAB.DEC_NAM, 
DECODE(AWUNADM.SAD_GENERAL_SEGMENT.IDE_REG_SER, 'P', 1, 0), DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'4000.000', 1, 0), 
TO_NUMBER(DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'1000.041', 0, '1000.000', 0, 1))*TO_NUMBER(DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'1000.041', 0, '1000.000', 0, '2000.000', 0, 
'3000.000', 0, '4000.000', '0', '4000.006', 0, '4000.042', 0, 1)), 
DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'1000.041', 1, '1000.000', 1, '2000.000', 1, '3000.000', 1, 0), 
DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'4000.042', 1, 0), 
DECODE(AWUNADM.SAD_ITEM.TAR_PRC_EXT||'.'||AWUNADM.SAD_ITEM.TAR_PRC_NAT, 
'4000.072', 1, 0), 
DECODE(SUBSTR(AWUNADM.SAD_ITEM.TAR_PRC_EXT, 1, 1), 7, 1, 8, 1, 0)]]>
	</queryString>
	<field name="IDE_REG_NBR" class="java.lang.String"/>
	<field name="KEY_ITM_NBR" class="java.math.BigDecimal"/>
	<field name="IM_EX" class="java.lang.String"/>
	<field name="TPT_CUO_COD" class="java.lang.String"/>
