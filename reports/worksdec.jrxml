	<field name="ITEM_NO" class="java.math.BigDecimal"/>
	<variable name="SDGSum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VIT_CIF}]]></variableExpression>
	</variable>
	<variable name="Pers" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PERSONAL}]]></variableExpression>
	</variable>
	<variable name="commercial" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{commercial}]]></variableExpression>
	</variable>
	<variable name="Other" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{OTHER}]]></variableExpression>
	</variable>
	<variable name="EX" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{EXPORTS}]]></variableExpression>
	</variable>
	<variable name="bill" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{BILL_TRANS}]]></variableExpression>
	</variable>
	<variable name="Dip" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DEPLOMATICS}]]></variableExpression>
	</variable>
	<variable name="With" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{WITHDRAWLS}]]></variableExpression>
	</variable>
	<variable name="Item" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{ITEM_NO}]]></variableExpression>
	</variable>
	<variable name="Form" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CERT_NO}]]></variableExpression>
	</variable>
